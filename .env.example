# Project Benjamin SRE Agentic Environment Configuration

# SRE Execution Mode: [MOCK / LIVE]
# LIVE mode runs real-time queries against GCP services.
SRE_MODE=LIVE

# SRE default Gemini model configuration coordinate
DEFAULT_GEMINI_MODEL=gemini-3.1-flash-lite

# Telegram Bot Integration (Optional)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Environment scope: [development / production / test] (aliases: dev, prod)
# Priority: BENJAMIN_ENV -> SRE_ENV -> PYTEST_CURRENT_TEST ("test") -> RAILS_ENV -> "development".
# Leave commented out locally so pytest runs automatically isolate into "test" (investigations/test/).
# BENJAMIN_ENV=development

# Storage Backend for Active State: [auto / local / db]
# - auto (default): uses DatabaseStateManager when Cloud SQL is active or BENJAMIN_ENV=production, else FileStateManager
# - local: always uses local filesystem (investigations/<env>/active_state.json)
# - db: uses Cloud SQL PostgreSQL with automatic local filesystem fallback
# STORAGE_BACKEND_STATE=auto

# Cloud SQL PostgreSQL Configuration (Uncomment to enable Cloud SQL state locally; in Cloud Run set via deploy flags)
# When DB_NAME is omitted, init_db() defaults to sredb_<env> (e.g. sredb_development, sredb_test, sredb_production).
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=sredb_development
# DB_USER=benjamin
# DB_PASS=benjamin_secret

# GCP Configuration (Required for LIVE mode)
GCP_PROJECT_ID=prod-db-999
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
