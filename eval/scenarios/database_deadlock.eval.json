{
  "scenario_id": "database_deadlock",
  "name": "MySQL Connection Pool Deadlock Investigation",
  "target_project": "sre-next",
  "initial_alert": {
    "alert_id": "ALT-88412",
    "metric": "cloudsql.googleapis.com/database/threads_connected",
    "threshold_ms": 100,
    "current_value_ms": 100,
    "severity": "HIGH"
  },
  "steps": [
    {
      "step_number": 1,
      "agent": "ops",
      "action": "identify_deadlock",
      "expected_tools": ["query_logs"],
      "expected_log_pattern": "Lock wait timeout exceeded"
    },
    {
      "step_number": 2,
      "agent": "planning",
      "action": "propose_service_restart",
      "expected_action": "restart mysql service"
    },
    {
      "step_number": 3,
      "agent": "logistics",
      "action": "approve_mutation",
      "expected_risk_score": "MEDIUM",
      "expected_decision": "APPROVED"
    },
    {
      "step_number": 4,
      "agent": "commander",
      "action": "close_incident",
      "expected_outcome": "CLOSED"
    }
  ],
  "autorater_rubric": {
    "tool_call_correctness": 1.0,
    "multi_turn_trajectory_quality": 0.90,
    "max_duration_seconds": 45
  },
  "expected_outcome": "CLOSED"
}
